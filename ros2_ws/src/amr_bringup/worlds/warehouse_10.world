        <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.65 0.55 0.35 1</ambient><diffuse>0.70 0.60 0.40 1</diffuse></material>
      </visual></link>
    </model>


    <!-- ==================== CEILING (60m × 40m) ==================== -->
    <!--  벽 높이 3.0m에 맞춰 천장 슬래브 Z=3.1 (두께 0.2m)            -->
    <!--  collision 없음 — LiDAR 간섭 방지, AMR 동작에 영향 없음        -->
    <!--  X방향 3패널 + 중앙 조명 슬롯으로 분할                         -->

    <!-- 서측 패널 (X=0~27) -->
    <model name="ceiling_west">
      <static>true</static>
      <pose>13.5 20 3.1 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>27 40 0.2</size></box></geometry>
          <material>
            <ambient>0.45 0.43 0.40 1</ambient>
            <diffuse>0.47 0.45 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 동측 패널 (X=33~60) -->
    <model name="ceiling_east">
      <static>true</static>
      <pose>46.5 20 3.1 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>27 40 0.2</size></box></geometry>
          <material>
            <ambient>0.45 0.43 0.40 1</ambient>
            <diffuse>0.47 0.45 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 중앙 조명 슬롯 (X=27~33) — 약간 어두운 색으로 조명 홈 표현 -->
    <model name="ceiling_light_slot">
      <static>true</static>
      <pose>30 20 3.1 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>6 40 0.2</size></box></geometry>
          <material>
            <ambient>0.30 0.30 0.28 1</ambient>
            <diffuse>0.32 0.32 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  <!-- ==================== CCTV CAMERAS (S-08 복도 감시) ====================
       위치: 복도 ① (B-C, wx=14.5) / 복도 ② (A-B, wx=49.5)
       z=2.99m (천장 3.0m 한계), pitch=+1.5708 rad (수직 하향 90°)
       FOV=95° (1.658 rad), 640×480, 15Hz
       topic: /cctv/{corridor_1s|corridor_1n|corridor_2s|corridor_2n}/image
  ============================================================ -->

    <!-- ① 복도 ① 남쪽 입구 (14.5, 9.5, 2.99) -->
    <model name="cctv_corridor_1s">
      <static>true</static>
      <pose>14.5 9.5 2.99 0 1.5708 0</pose>
      <link name="link">
        <visual name="body">
          <geometry><box><size>0.08 0.08 0.06</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
        <sensor name="cctv_corridor_1s_camera" type="camera">
          <topic>/cctv/corridor_1s/image</topic>
          <camera>
            <horizontal_fov>1.658</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>10.0</far></clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
            <camera_info_topic>/cctv/corridor_1s/camera_info</camera_info_topic>
          </camera>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>

    <!-- ② 복도 ① 북쪽 입구 (14.5, 14.5, 2.99) -->
    <model name="cctv_corridor_1n">
      <static>true</static>
      <pose>14.5 14.5 2.99 0 1.5708 0</pose>
      <link name="link">
        <visual name="body">
          <geometry><box><size>0.08 0.08 0.06</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
        <sensor name="cctv_corridor_1n_camera" type="camera">
          <topic>/cctv/corridor_1n/image</topic>
          <camera>
            <horizontal_fov>1.658</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>10.0</far></clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
            <camera_info_topic>/cctv/corridor_1n/camera_info</camera_info_topic>
          </camera>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>

    <!-- ③ 복도 ② 남쪽 입구 (49.5, 15.5, 2.99) -->
    <model name="cctv_corridor_2s">
      <static>true</static>
      <pose>49.5 15.5 2.99 0 1.5708 0</pose>
      <link name="link">
        <visual name="body">
          <geometry><box><size>0.08 0.08 0.06</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
        <sensor name="cctv_corridor_2s_camera" type="camera">
          <topic>/cctv/corridor_2s/image</topic>
          <camera>
            <horizontal_fov>1.658</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>10.0</far></clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
            <camera_info_topic>/cctv/corridor_2s/camera_info</camera_info_topic>
          </camera>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>

    <!-- ④ 복도 ② 북쪽 입구 (49.5, 20.5, 2.99) -->
    <model name="cctv_corridor_2n">
      <static>true</static>
      <pose>49.5 20.5 2.99 0 1.5708 0</pose>
      <link name="link">
        <visual name="body">
          <geometry><box><size>0.08 0.08 0.06</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
        <sensor name="cctv_corridor_2n_camera" type="camera">
          <topic>/cctv/corridor_2n/image</topic>
          <camera>
            <horizontal_fov>1.658</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>10.0</far></clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
            <camera_info_topic>/cctv/corridor_2n/camera_info</camera_info_topic>
          </camera>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>

</world>
</sdf>
