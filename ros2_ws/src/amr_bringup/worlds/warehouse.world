<?xml version="1.0"?>
<sdf version="1.8">
  <world name="warehouse">
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <!-- ============================================================ -->
    <!--  Opticore Logistics Warehouse                                -->
    <!--  Size: 40m × 30m (internal usable area)                      -->
    <!--  Layout:                                                      -->
    <!--    - 4 rack rows (each 3 racks) in center                    -->
    <!--    - 3m corridors between rows                                -->
    <!--    - Loading zone (left wall)                                 -->
    <!--    - Unloading zone (right wall)                              -->
    <!--    - Charging station (bottom-right corner)                   -->
    <!--    - Columns for structural realism                           -->
    <!-- ============================================================ -->

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Lighting -->
    <light type="directional" name="warehouse_light_1">
      <cast_shadows>true</cast_shadows>
      <pose>20 15 12 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 -0.2 -1.0</direction>
    </light>

    <light type="directional" name="warehouse_light_2">
      <cast_shadows>false</cast_shadows>
      <pose>20 15 12 0 0 0</pose>
      <diffuse>0.4 0.4 0.45 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 0.2 -1.0</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>50 40</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.6</mu>       <!-- 정지 마찰: 에폭시 코팅 바닥 기준 (1.0은 드라이 고무 수준으로 너무 높음) -->
                <mu2>0.5</mu2>     <!-- 횡방향 슬립 마찰 -->
                <slip1>0.003</slip1>   <!-- 종방향 미끄럼 허용 -->
                <slip2>0.003</slip2>   <!-- 횡방향 미끄럼 허용 -->
                <fdir1>1 0 0</fdir1>   <!-- 주 마찰 방향: X축 (전진 방향) -->
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>           <!-- 접촉 강성: 딱딱한 콘크리트 바닥 -->
              <kd>100.0</kd>         <!-- 접촉 댐핑 -->
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>50 40</size></plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.58 1</ambient>
            <diffuse>0.6 0.6 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== WALLS ==================== -->

    <!-- North wall (back) -->
    <model name="wall_north">
      <static>true</static>
      <pose>20 30 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 0.2 3.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.65 1</ambient><diffuse>0.7 0.7 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall (front) -->
    <model name="wall_south">
      <static>true</static>
      <pose>20 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 0.2 3.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.65 1</ambient><diffuse>0.7 0.7 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall (left) -->
    <model name="wall_west">
      <static>true</static>
      <pose>0 15 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 30 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 30 3.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.65 1</ambient><diffuse>0.7 0.7 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall (right) -->
    <model name="wall_east">
      <static>true</static>
      <pose>40 15 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 30 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 30 3.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.65 1</ambient><diffuse>0.7 0.7 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== STORAGE RACKS ==================== -->
    <!--
      Layout (top view, Y-up):

      Y=30 ┌──────────────────────────────────────┐ North wall
           │                                        │
           │   [Rack Row 4]  y≈24                   │
           │   ─── corridor 3m ───                  │
           │   [Rack Row 3]  y≈19                   │
           │   ─── corridor 3m ───                  │
           │   [Rack Row 2]  y≈14                   │
           │   ─── corridor 3m ───                  │
           │   [Rack Row 1]  y≈9                    │
           │                                        │
      Y=0  └──────────────────────────────────────┘ South wall
           X=0  Loading                    Unloading  X=40
                Zone                       Zone
    -->

    <!-- Rack: 6m long × 1m deep × 2.5m tall -->

    <!-- Row 1 (y=9) -->
    <model name="rack_r1_1">
      <static>true</static>
      <pose>10 9 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 1.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 1.0 2.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_r1_2">
      <static>true</static>
      <pose>20 9 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 1.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 1.0 2.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_r1_3">
      <static>true</static>
      <pose>30 9 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 1.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 1.0 2.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Row 2 (y=14) -->
    <model name="rack_r2_1">
      <static>true</static>
      <pose>10 14 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 1.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 1.0 2.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_r2_2">
      <static>true</static>
      <pose>20 14 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 1.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 1.0 2.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_r2_3">
      <static>true</static>
      <pose>30 14 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 1.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 1.0 2.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Row 3 (y=19) -->
    <model name="rack_r3_1">
      <static>true</static>
      <pose>10 19 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 1.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 1.0 2.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_r3_2">
      <static>true</static>
      <pose>20 19 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 1.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 1.0 2.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_r3_3">
      <static>true</static>
      <pose>30 19 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 1.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 1.0 2.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Row 4 (y=24) -->
    <model name="rack_r4_1">
      <static>true</static>
      <pose>10 24 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 1.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 1.0 2.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_r4_2">
      <static>true</static>
      <pose>20 24 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 1.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 1.0 2.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_r4_3">
      <static>true</static>
      <pose>30 24 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 1.0 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 1.0 2.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.3 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== STRUCTURAL COLUMNS ==================== -->

    <model name="column_1">
      <static>true</static>
      <pose>5 7.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="column_2">
      <static>true</static>
      <pose>35 7.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="column_3">
      <static>true</static>
      <pose>5 25.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="column_4">
      <static>true</static>
      <pose>35 25.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== LOADING ZONE (West side) ==================== -->

    <model name="loading_zone">
      <static>true</static>
      <pose>3 15 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4.0 8.0 0.001</size></box></geometry>
          <material><ambient>0.2 0.5 0.2 0.8</ambient><diffuse>0.2 0.6 0.2 0.8</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Loading dock — 높이 0.3 → 1.5m (LiDAR 감지 가능) -->
    <model name="loading_dock">
      <static>true</static>
      <pose>1.0 15 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 6.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5 6.0 1.5</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== UNLOADING ZONE (East side) ==================== -->

    <model name="unloading_zone">
      <static>true</static>
      <pose>37 15 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4.0 8.0 0.001</size></box></geometry>
          <material><ambient>0.5 0.2 0.2 0.8</ambient><diffuse>0.6 0.2 0.2 0.8</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Unloading dock — 높이 0.3 → 1.5m (LiDAR 감지 가능) -->
    <model name="unloading_dock">
      <static>true</static>
      <pose>39.0 15 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 6.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5 6.0 1.5</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== CHARGING STATION (SE corner) ==================== -->

    <model name="charging_station">
      <static>true</static>
      <pose>37 3 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3.0 3.0 0.001</size></box></geometry>
          <material><ambient>0.2 0.2 0.6 0.8</ambient><diffuse>0.2 0.2 0.7 0.8</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Charging post (높이 1.0m — 이미 LiDAR 감지 가능) -->
    <model name="charging_post">
      <static>true</static>
      <pose>38 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.8 1</ambient><diffuse>0.3 0.3 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== STATIC OBSTACLES ==================== -->

    <model name="pallet_1">
      <static>true</static>
      <pose>15 11.5 0.25 0 0 0.1</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.8 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.8 0.5</size></box></geometry>
          <material><ambient>0.6 0.5 0.3 1</ambient><diffuse>0.65 0.55 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_stack_1">
      <static>true</static>
      <pose>25 16.5 0.3 0 0 -0.05</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.65 0.55 0.35 1</ambient><diffuse>0.7 0.6 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== DYNAMIC OBSTACLES (주석 처리였는데 이젠 아니지롱) ==================== -->

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Casual%20male</uri>
      <name>person_1</name>
      <pose>12.0 16.0 0.0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
      <name>forklift_1</name>
      <pose>28.0 21.0 0.0 0 0 0.3</pose>
    </include>

  </world>
</sdf>
