    <!-- ==================== DYNAMIC OBSTACLES ==================== -->
    <!-- 초기 스폰 위치만 설정 — 이동 경로는 dynamic_obstacle_mover.py 담당 -->
    <include>
      <uri>model://standing_person</uri>
      <name>person_1</name>
      <pose>14.0 18.0 0.0 0 0 0</pose>
    </include>

    <!-- person_2: Row A 남쪽 면 옆 (동적, 1m 왕복) -->
