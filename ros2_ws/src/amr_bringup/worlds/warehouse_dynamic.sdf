      <uri>model://standing_person</uri>
      <name>person_2</name>
      <pose>32.0 20.0 0.0 0 0 0</pose>
    </include>

    <!-- person_3: Row B 남쪽 면 옆 (동적, 1m 왕복) -->
    <include>
      <uri>model://standing_person</uri>
      <name>person_3</name>
      <pose>25.0 14.0 0.0 0 0 0</pose>
    </include>

    <!-- person_s1: 트럭 뒤 occlusion (정적) -->
